FROM docker.io/library/caddy:2.10.2-alpine AS caddy-bin

FROM docker.io/library/python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl iproute2 openssl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=caddy-bin /usr/bin/caddy /usr/bin/caddy
COPY scripts/render_macos_private_edge.py scripts/site_registry.py /opt/wiring-harness/scripts/
COPY tests/containers/macos-private-edge/backend.py /usr/local/bin/macos-edge-http-backend
COPY --chmod=0755 tests/containers/macos-private-edge/run-test.sh /usr/local/bin/run-macos-edge-test

ENTRYPOINT ["/usr/local/bin/run-macos-edge-test"]
