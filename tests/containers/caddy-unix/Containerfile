FROM docker.io/library/caddy:2.10.2-alpine AS caddy-bin

FROM docker.io/library/python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl openssl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=caddy-bin /usr/bin/caddy /usr/bin/caddy
COPY scripts/setup_caddy.py scripts/site_registry.py /opt/wiring-harness/scripts/
COPY tests/containers/caddy-unix/backend.py /usr/local/bin/unix-http-backend
COPY --chmod=0755 tests/containers/caddy-unix/run-test.sh /usr/local/bin/run-caddy-unix-test

ENTRYPOINT ["/usr/local/bin/run-caddy-unix-test"]
